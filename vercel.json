{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": true
  },
  "ignoreCommand": "node scripts/ugo-test-only-vercel-ignore.mjs",
  "buildCommand": "npm run build:prod",
  "outputDirectory": "dist",
  "framework": "vite",
  "env": {
    "SUPABASE_URL": "https://trfsjuseqjxlhrxuvdsm.supabase.co",
    "SUPABASE_ANON_KEY": "sb_publishable_bbCcM7ElzH-iGAQw8Qefzg_ZmO0sKH8",
    "VITE_SUPABASE_URL": "https://trfsjuseqjxlhrxuvdsm.supabase.co",
    "VITE_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_bbCcM7ElzH-iGAQw8Qefzg_ZmO0sKH8"
  },
  "rewrites": [
    {
      "source": "/api/ugo-support",
      "destination": "/api/ugo-support"
    },
    {
      "source": "/api/admin/create-user",
      "destination": "/api/proxy?admin_create_user=1"
    },
    {
      "source": "/api/hugo/gemini",
      "destination": "/api/test"
    },
    {
      "source": "/api/pagos/efectivo",
      "destination": "/api/operations?op=cash-select"
    },
    {
      "source": "/api/pagos/confirmar-efectivo",
      "destination": "/api/operations?op=cash-confirm"
    },
    {
      "source": "/api/kyc/verify",
      "destination": "/api/operations?op=kyc-verify"
    },
    {
      "source": "/api/calendar/start",
      "destination": "/api/test?ugo_calendar=start"
    },
    {
      "source": "/api/calendar/callback",
      "destination": "/api/test?ugo_calendar=callback"
    },
    {
      "source": "/api/calendar/status",
      "destination": "/api/test?ugo_calendar=status"
    },
    {
      "source": "/api/calendar/sync",
      "destination": "/api/test?ugo_calendar=sync"
    },
    {
      "source": "/api/calendar/disconnect",
      "destination": "/api/test?ugo_calendar=disconnect"
    },
    {
      "source": "/api/disputes/analyze",
      "destination": "/api/test?ugo_dispute_ai=1"
    },
    {
      "source": "/api/scout/gmail",
      "destination": "/api/scout/places?ugo_scout_gmail=1"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/provider.html",
      "destination": "/provider.html"
    },
    {
      "source": "/client.html",
      "destination": "/client.html"
    },
    {
      "source": "/scout.html",
      "destination": "/scout.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
