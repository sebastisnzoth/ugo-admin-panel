{
  "name": "ugo-deploy",
  "private": true,
  "_redeploy": "20260915-public-development-no-login",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "verify:test-env": "node scripts/assert-test-environment.mjs",
    "build": "npm run verify:test-env && tsc -b && vite build",
    "lint": "eslint .",
    "test": "npm run verify:test-env && node --test tests/**/*.test.mjs",
    "test:p0": "npm run verify:test-env && node --test tests/contracts/first-client-readiness.test.mjs tests/contracts/client-cancel-actions.test.mjs tests/contracts/client-provider-lifecycle.test.mjs tests/contracts/client-live-assignment-notification.test.mjs",
    "test:integration": "npm run verify:test-env && node --test tests/integration/**/*.test.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.1",
    "@tomtom-org/maps-sdk": "^0.34.0",
    "maplibre-gl": "^6.9.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
