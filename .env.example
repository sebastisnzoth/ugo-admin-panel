VITE_SUPABASE_URL=https://trfsjuseqjxlhrxuvdsm.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_bbCcM7ElzH-iGAQw8Qefzg_ZmO0sKH8

# OpenAI — Hugo Voice. OPENAI_API_KEY es secreta y solo vive en Vercel/server.
# Nunca usar VITE_OPENAI_API_KEY ni exponer la key en el navegador.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin

# Token interno para que los endpoints serverless lean claves secretas de
# config_sistema vía el RPC config_backend(). Debe coincidir con la fila
# config_sistema.backend_api_token. Configurarlo en Vercel → Settings →
# Environment Variables (Production + Preview). NUNCA commitear el valor.
# Rotación: openssl rand -hex 24 → actualizar fila en DB + env var + redeploy.
UGO_BACKEND_TOKEN=

# Payments — secretos solo server-side. Nunca usar prefijo VITE_.
MERCADO_PAGO_ACCESS_TOKEN=

# OpenPix permanece apagado por defecto. En esta fase solo se habilita sandbox
# para cuentas @ugo.test. No usar AppID de producción aquí.
PAYMENTS_OPENPIX_ENABLED=false
OPENPIX_SANDBOX_APP_ID=

# Argentina se mantiene declarada pero apagada hasta la fase Mercado Pago AR.
PAYMENTS_ARGENTINA_ENABLED=false
