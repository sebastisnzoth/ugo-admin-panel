# UGO TEST — ambiente activo mientras se valida el flujo real Cliente ↔ Proveedor ↔ Admin.
# Producción NO se usa desde main durante esta fase.
VITE_SUPABASE_URL=https://tmossnqfwfwjrtzwcbmm.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_meCpkMt79S25M0nHgVv1aQ_V9AMPZEl

# OpenAI — Hugo Voice. OPENAI_API_KEY es secreta y solo vive en Vercel/server.
# Nunca usar VITE_OPENAI_API_KEY ni exponer la key en el navegador.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin

# Token interno para endpoints serverless. Nunca commitear su valor.
UGO_BACKEND_TOKEN=

# Payments — secretos solo server-side. Nunca usar prefijo VITE_.
MERCADO_PAGO_ACCESS_TOKEN=
# Chave Pix pública de UGO. Usada server-side para generar el Pix de comisión del proveedor.
UGO_PIX_KEY=

# OpenPix permanece apagado por defecto. En TEST sólo sandbox para cuentas de prueba.
PAYMENTS_OPENPIX_ENABLED=false
OPENPIX_SANDBOX_APP_ID=

# Argentina se mantiene declarada pero apagada hasta la fase Mercado Pago AR.
PAYMENTS_ARGENTINA_ENABLED=false

# Uber Direct — logística/courier. Secretos solo server-side; obtenerlos en direct.uber.com.
# Usar credenciales TEST hasta validar E2E. Customer ID identifica la organización Direct.
UBER_DIRECT_CLIENT_ID=
UBER_DIRECT_CLIENT_SECRET=
UBER_DIRECT_CUSTOMER_ID=
# Opcional: dejar vacío para usar https://api.uber.com/v1
UBER_DIRECT_API_BASE_URL=

# Google Calendar Proveedor — OAuth server-side. UGO es source of truth.
# Crear credenciales OAuth Web y registrar exactamente GOOGLE_CALENDAR_REDIRECT_URI.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=
GOOGLE_CALENDAR_STATE_SECRET=
# Base pública usada para volver a UGO después del OAuth (ej. https://tu-dominio.vercel.app).
UGO_PUBLIC_BASE_URL=
# Requerida por endpoints server-side para guardar tokens y sincronizar eventos.
SUPABASE_SERVICE_ROLE_KEY=

# Scout — TomTom Search/POI. Secreto sólo server-side; Scout lo consume en /api/scout/places.
TOMTOM_API_KEY=
# Fallback opcional de Scout cuando TomTom no devuelve resultados.
GEOAPIFY_API_KEY=
# Reclutamiento por email Scout (server-side).
RESEND_API_KEY=
SCOUT_EMAIL_FROM=

# Gemini — Hugo y asistencia de disputas. Sólo server-side.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Transcripción de voz cliente/proveedor por WebSocket Live. La key nunca llega al navegador: se emite token efímero autenticado.
GEMINI_LIVE_TRANSCRIBE_MODEL=gemini-3.5-transcribe-live
GEMINI_DISPUTE_MODEL=gemini-3.5-flash-lite
