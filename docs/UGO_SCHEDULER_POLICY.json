    "client-payment": 1,
    "client-request-flow": 1,
    "client-service-status": 1,
    "client-shell": 1,
    "disputes": 1,
    "hugo-actions": 1,
    "hugo-authority": 1,
    "hugo-intent": 1,
    "hugo-security": 1,
    "hugo-session": 1,
    "hugo-shell": 1,
    "hugo-voice": 1,
    "notifications": 1,
    "provider-demand": 1,
    "provider-finance": 1,
    "provider-history": 1,
    "provider-job-state": 1,
    "provider-location": 1,
    "provider-media": 1,
    "provider-shell": 1,
    "security-rls": 1
  },
  "task_policies": {
    "worker-autonomy": {
      "priority": "CRITICAL",
      "risk": "MEDIUM",
