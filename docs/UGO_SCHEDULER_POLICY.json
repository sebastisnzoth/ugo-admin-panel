    "model-router-runtime": {
      "priority": "HIGH",
      "risk": "LOW",
      "human_gate": false
    },
    "qa-simulator-binding": {
      "priority": "CRITICAL",
      "risk": "MEDIUM",
      "human_gate": false
    },
    "chaos-p0": {
      "priority": "HIGH",
      "risk": "HIGH",
      "human_gate": false
    },
    "remediation-regression": {
      "priority": "HIGH",
      "risk": "MEDIUM",
      "human_gate": false
    },
    "release-gate": {
      "priority": "CRITICAL",
      "risk": "MEDIUM",
      "human_gate": false
    },
    "audit-event-binding": {
      "priority": "CRITICAL",
      "risk": "MEDIUM",
      "human_gate": false
    },
    "complete-test-journey": {
      "priority": "CRITICAL",
