    },
    "founder-challenge": {
      "priority": "CRITICAL",
      "risk": "HIGH",
      "human_gate": true
    },
    "physical-gps": {
      "priority": "CRITICAL",
      "risk": "HIGH",
      "human_gate": true
    },
    "real-customer-acceptance": {
      "priority": "CRITICAL",
      "risk": "HIGH",
      "human_gate": true
    }
