    "super-admin-ui": 1,
    "payments": 1,
    "ratings": 1,
    "ugo-test-worker": 1,
    "autonomy-state": 1,
    "recovery": 1,
    "regression": 1,
    "d14-audit": 1,
    "customer1": 1,
    "customer1-device-test": 1,
    "physical-gps": 1,
    "founder-challenge": 1,
    "ugo-empresas": 1,
